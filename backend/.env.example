# Copy this file to backend\.env (setup.bat does it for you). NEVER commit .env to Git.
# Only OLLAMA_* and RAG_* names are read from this file.

# --- Language model (Ollama runs on this computer) ---
OLLAMA_MODEL=qwen2.5:3b
# On a 4 GB RAM computer the smaller model is safer:  OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=2m

# --- Retrieval limits ---
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_CHUNK_CHARS=2500
RAG_MIN_SIMILARITY=0.15

# --- Local server ---
RAG_HOST=127.0.0.1
RAG_PORT=8000

# --- Browser access ---
# Websites allowed to talk to this backend, comma separated, exact origins only
# (example: https://my-app.vercel.app). Leave empty to allow only the local dev pages.
RAG_TRUSTED_ORIGINS=

# --- Optional extra lock: only these folders may be used as repositories ---
# Separate several folders with ; on Windows. Example: RAG_ALLOWED_ROOTS=C:\Users\You\Desktop
# RAG_ALLOWED_ROOTS=

# --- Optional HTTPS for the local API (see docs/DEPLOYMENT.md) ---
# RAG_SSL_CERTFILE=C:\path\to\127.0.0.1.pem
# RAG_SSL_KEYFILE=C:\path\to\127.0.0.1-key.pem

# --- Performance and limits ---
# Reuse the embedding model between requests (uses ~100 MB RAM while the server runs).
# Set to 0 on a very small machine to reload it for every request instead.
RAG_EMBEDDING_CACHE=1
# Change Impact analysis limits (defaults shown)
# RAG_IMPACT_MAX_FILES=2500
# RAG_IMPACT_MAX_FILE_BYTES=512000
# RAG_IMPACT_MAX_TOTAL_BYTES=8000000
# RAG_IMPACT_MAX_SECONDS=20
